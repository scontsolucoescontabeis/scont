{
  "name": "scont-renomeador",
  "version": "1.1.0",
  "description": "SCONT - Renomeador de Arquivos em Lote",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64"
  },
  "build": {
    "appId": "br.com.scont.renomeador",
    "productName": "SCONT Renomeador",
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  }
}
